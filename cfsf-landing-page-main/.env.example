# Environment Variables

# API Configuration
REACT_APP_API_URL=https://api.chanceforsouls.org
REACT_APP_API_TIMEOUT=10000

# Supabase (browser-safe values only)
# Project Settings -> API. NEVER put the database connection string,
# the service_role key, or the DB password in this file - CRA inlines
# every REACT_APP_* var into the public JS bundle.
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=

# Analytics
REACT_APP_GA_TRACKING_ID=
REACT_APP_HOTJAR_ID=

# External Services
# PUBLIC key only (pk_test_... / pk_live_...). A secret key (sk_...)
# must never appear in a REACT_APP_* var - it ships in the public bundle.
REACT_APP_PAYSTACK_PUBLIC_KEY=
REACT_APP_STRIPE_PUBLIC_KEY=
REACT_APP_PAYPAL_CLIENT_ID=

# Feature Flags
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_LIVE_CHAT=false
REACT_APP_ENABLE_NEWSLETTER=true
REACT_APP_ENABLE_TESTIMONIALS=true

# Contact Information
REACT_APP_CONTACT_EMAIL=info@chanceforsouls.org
REACT_APP_CONTACT_PHONE=+1-555-123-4567
REACT_APP_SUPPORT_EMAIL=support@chanceforsouls.org

# Social Media
REACT_APP_FACEBOOK_URL=https://facebook.com/chanceforsouls
REACT_APP_TWITTER_URL=https://twitter.com/chanceforsouls
REACT_APP_INSTAGRAM_URL=https://instagram.com/chanceforsouls
REACT_APP_LINKEDIN_URL=https://linkedin.com/company/chanceforsouls
REACT_APP_YOUTUBE_URL=https://youtube.com/chanceforsouls

# Development
REACT_APP_DEV_MODE=true
REACT_APP_DEBUG_MODE=false