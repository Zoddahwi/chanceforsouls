# Production build configuration.
#
# Tracked in git ON PURPOSE: these are build-tool flags and browser-public
# values, not secrets. CRA inlines every REACT_APP_* var into the public
# bundle, so nothing secret can ever live in this file.
#
# Secrets (Paystack sk_*, Supabase service_role key, DB connection URL)
# belong in the hosting provider's environment variables, or server-side only.

# Build tooling
ESLINT_NO_DEV_ERRORS=true
DISABLE_ESLINT_PLUGIN=true
SKIP_PREFLIGHT_CHECK=true
GENERATE_SOURCEMAP=true

# Backend API (owns the database)
REACT_APP_API_URL=https://api.chanceforsouls.org

# NOTE: REACT_APP_PAYSTACK_PUBLIC_KEY is intentionally NOT set here.
# Set it in your hosting provider's environment variables
# (Cloudflare Pages -> Settings -> Environment variables), so test and
# live deployments can use different pk_* keys.
# Without it, src/components/Donation.js falls back to a placeholder
# and payments will not work.
